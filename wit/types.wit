package hearthsound:plugin@0.5.0;

interface types {
  enum entity-kind { track, album, artist, playlist }
  /// Namespaced identifier: ("isrc", ...), ("mb-recording", ...), ("mb-release", ...), ("mb-release-group", ...), ("mb-artist", ...), ("upc", ...), or the provider's own namespace.
  record id-pair { namespace: string, value: string }
  record artist-credit { name: string, ids: list<id-pair> }
  record image { url: string, width: option<u32>, height: option<u32> }
  /// A coarse album row the provider can list without its tracklist.
  ///
  /// `album-type` is lowercase: `album`, `ep` or `single`, or a secondary type
  /// (`compilation`, `live`, `remix`, `soundtrack`, `dj-mix`, `demo`,
  /// `broadcast`, `other`) when the release group carries one. A secondary type
  /// wins over the primary one. `edition` is the provider's own disambiguation of
  /// this pressing, when it has one. `track-count` is the provider's track count
  /// for this release. `ids` carries every canonical identifier the provider
  /// knows for it (`mb-release`, `mb-release-group`, `upc`).
  record album-ref {
    id: string, title: string, artists: list<artist-credit>, year: option<u16>,
    images: list<image>, album-type: option<string>, edition: option<string>,
    track-count: option<u32>, ids: list<id-pair>,
  }
  record track {
    id: string, title: string, artists: list<artist-credit>, album: option<album-ref>,
    duration-ms: option<u32>, disc-number: option<u16>, track-number: option<u16>,
    isrc: option<string>, explicit: option<bool>, ids: list<id-pair>,
  }
  record album {
    id: string, title: string, artists: list<artist-credit>, release-date: option<string>,
    album-type: option<string>, upc: option<string>, genres: list<string>,
    images: list<image>, tracks: list<track>, ids: list<id-pair>,
    /// The provider's own disambiguation of this pressing, when it has one.
    edition: option<string>,
  }
  record artist {
    id: string, name: string, images: list<image>, ids: list<id-pair>,
    /// Albums the provider reports for this artist, when it reports a count.
    /// This is the provider's own count, not the number of albums the server
    /// stores.
    album-count: option<u32>,
  }
  variant provider-error {
    not-found, rate-limited(u32), unauthorized(string), invalid-config(string),
    unavailable(string), internal(string),
  }
  record user-context { user-id: string, config: option<string> }
}
