package hearthsound:plugin@0.1.0;

world base {
  import host-log;
  import host-http;
  import host-kv;
  import host-config;
  export lifecycle;
}
world catalog-provider { include base; export catalog; }
world metadata-provider { include base; export metadata; }
world acquisition-provider { include base; import host-files; export acquisition; }
