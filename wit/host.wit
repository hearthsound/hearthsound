package hearthsound:plugin@0.4.0;

interface host-log {
  enum level { trace, debug, info, warn, error }
  log: func(level: level, message: string);
}

interface host-http {
  record request { method: string, url: string, headers: list<tuple<string, string>>, body: option<list<u8>>, timeout-ms: option<u32> }
  record response { status: u16, headers: list<tuple<string, string>>, body: list<u8> }
  variant http-error { denied(string), timeout, body-too-large, network(string) }
  send: func(req: request) -> result<response, http-error>;
}

interface host-kv {
  /// Reads `key`.
  ///
  /// Returns `ok(none)` when the key is absent or has expired. Returns
  /// `err(reason)` when the store cannot be read, so a guest can tell a miss
  /// from a failure.
  get: func(key: string) -> result<option<list<u8>>, string>;
  set: func(key: string, value: list<u8>, ttl-ms: option<u64>) -> result<_, string>;
  delete: func(key: string);
}

interface host-config {
  /// JSON of this provider instance's server-scoped config, secrets decrypted.
  server-config: func() -> string;
}

interface host-files {
  record file-stat { size: u64, modified-ms: u64, is-dir: bool }
  /// root: an import-root id granted to this instance, or "staging".
  stat: func(root: string, path: string) -> option<file-stat>;
  list-dir: func(root: string, path: string) -> result<list<string>, string>;
}

/// Runs an external tool the administrator configured, for acquisition plugins that need one.
interface host-process {
  /// An opaque handle to a process this instance started.
  type process-handle = u64;
  /// Where the process's standard output goes.
  variant stdout-mode {
    /// Kept in memory, at most 1 MiB unread; read it with read-stdout.
    capture,
    /// Written to this path, relative to the current staging directory.
    file(string),
  }
  record spawn-options {
    /// Working directory relative to the current staging directory; none is the staging directory itself.
    cwd: option<string>,
    /// Extra environment entries; every name must be listed in the tool's environment allowlist.
    env: list<tuple<string, string>>,
    stdout: stdout-mode,
    /// Wall-clock limit after which the host kills the process; at most 3600000.
    timeout-ms: u32,
  }
  variant process-state { running, exited(s32), killed, timed-out }
  variant process-error {
    /// The tool is not in the manifest's process tools, or an option broke a rule.
    denied(string),
    /// The administrator has not set a usable path for the tool.
    not-configured(string),
    /// The operating system refused to start the process.
    spawn-failed(string),
    /// The handle is unknown to this instance or already released.
    unknown-handle,
  }
  /// Starts `tool` (a name from the manifest, never a path) with `args` as its argument vector; no shell is involved.
  spawn: func(tool: string, args: list<string>, options: spawn-options) -> result<process-handle, process-error>;
  poll: func(handle: process-handle) -> result<process-state, process-error>;
  /// Returns and drains the captured standard output gathered since the last read.
  read-stdout: func(handle: process-handle) -> result<list<u8>, process-error>;
  /// Returns and drains the standard error gathered since the last read (always captured, at most 1 MiB unread).
  read-stderr: func(handle: process-handle) -> result<list<u8>, process-error>;
  /// Kills the process when it still runs and releases the handle.
  kill: func(handle: process-handle);
}
