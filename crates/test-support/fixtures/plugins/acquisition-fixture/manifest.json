{
  "manifestVersion": 1,
  "id": "com.example.acquisition-fixture",
  "name": "Acquisition fixture",
  "version": "0.1.0",
  "description": "An acquisition plugin that simulates a downloader through host-kv and host-files.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/hearthsound",
  "api": "hearthsound:plugin@0.2.0",
  "provides": ["acquisition"],
  "permissions": {
    "kv": { "maxBytes": 1048576 },
    "files": { "importRoots": true }
  },
  "config": {
    "server": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "candidates": { "type": "array", "title": "Candidates", "items": { "type": "object" } },
          "searchPolls": { "type": "integer", "title": "Search polls", "default": 1 },
          "downloadQueuedPolls": { "type": "integer", "title": "Queued polls", "default": 1 },
          "downloadRunningPolls": { "type": "integer", "title": "Running polls", "default": 2 },
          "outputRoot": { "type": "string", "title": "Output root", "default": "staging" },
          "matchSuffix": { "type": "string", "title": "Output file suffix" },
          "scenario": { "type": "string", "title": "Scenario", "default": "normal" },
          "progressive": { "type": "boolean", "title": "Progressive", "default": false },
          "granularities": { "type": "array", "items": { "type": "string" }, "default": ["track", "album"] }
        }
      },
      "uiSchema": {
        "type": "VerticalLayout",
        "elements": [
          { "type": "Control", "scope": "#/properties/candidates" },
          { "type": "Control", "scope": "#/properties/searchPolls" },
          { "type": "Control", "scope": "#/properties/downloadQueuedPolls" },
          { "type": "Control", "scope": "#/properties/downloadRunningPolls" },
          { "type": "Control", "scope": "#/properties/outputRoot" },
          { "type": "Control", "scope": "#/properties/matchSuffix" },
          { "type": "Control", "scope": "#/properties/scenario" },
          { "type": "Control", "scope": "#/properties/progressive" },
          { "type": "Control", "scope": "#/properties/granularities" }
        ]
      }
    },
    "user": null
  },
  "resources": { "memoryMb": 64, "callTimeoutMs": 5000, "maxInstances": 2 }
}
