{
  "manifestVersion": 1,
  "id": "com.example.verification-fixture",
  "name": "Verification fixture",
  "version": "0.1.0",
  "description": "A verification plugin that answers from the fingerprints an administrator lists and matches everything else.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/hearthsound",
  "api": "hearthsound:plugin@0.4.0",
  "provides": ["verification"],
  "permissions": {},
  "config": {
    "server": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "rejectFingerprints": {
            "type": "array",
            "title": "Rejected fingerprints",
            "items": { "type": "string", "title": "Fingerprint" }
          },
          "unknownFingerprints": {
            "type": "array",
            "title": "Unknown fingerprints",
            "items": { "type": "string", "title": "Fingerprint" }
          },
          "fail": {
            "type": "boolean",
            "title": "Fail every check"
          }
        }
      },
      "uiSchema": {
        "type": "VerticalLayout",
        "elements": [
          { "type": "Control", "scope": "#/properties/rejectFingerprints" },
          { "type": "Control", "scope": "#/properties/unknownFingerprints" },
          { "type": "Control", "scope": "#/properties/fail" }
        ]
      }
    },
    "user": null
  },
  "resources": { "memoryMb": 64, "callTimeoutMs": 5000, "maxInstances": 2 }
}
