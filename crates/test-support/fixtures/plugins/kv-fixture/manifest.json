{
  "manifestVersion": 1,
  "id": "com.example.kv-fixture",
  "name": "Key-value fixture",
  "version": "0.1.0",
  "description": "A catalog plugin whose search reports what a host-kv read returned.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/hearthsound",
  "api": "hearthsound:plugin@0.4.0",
  "provides": ["catalog"],
  "permissions": {
    "kv": { "maxBytes": 1048576 }
  },
  "config": {
    "server": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      },
      "uiSchema": {
        "type": "VerticalLayout",
        "elements": []
      }
    },
    "user": null
  },
  "resources": { "memoryMb": 64, "callTimeoutMs": 5000, "maxInstances": 2 },
  "catalog": { "imageCachePolicy": "cache" }
}
