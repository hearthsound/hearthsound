{
  "manifestVersion": 1,
  "id": "com.example.process-fixture",
  "name": "Process fixture",
  "version": "0.1.0",
  "description": "An acquisition plugin that downloads through the yt-dlp tool.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/hearthsound",
  "api": "hearthsound:plugin@0.3.0",
  "provides": ["acquisition"],
  "permissions": {
    "kv": { "maxBytes": 1048576 },
    "process": { "tools": ["yt-dlp"] }
  },
  "config": {
    "server": null,
    "user": null
  },
  "resources": { "memoryMb": 64, "callTimeoutMs": 30000, "maxInstances": 2 }
}
