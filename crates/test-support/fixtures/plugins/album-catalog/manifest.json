{
  "manifestVersion": 1,
  "id": "com.example.album-catalog",
  "name": "Album catalog",
  "version": "0.1.0",
  "description": "A catalog plugin whose album holds five tracks, for multi-track tests.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/hearthsound",
  "api": "hearthsound:plugin@0.1.0",
  "provides": ["catalog"],
  "permissions": {},
  "config": {
    "server": null,
    "user": null
  },
  "resources": { "memoryMb": 64, "callTimeoutMs": 5000, "maxInstances": 2 },
  "catalog": { "imageCachePolicy": "no-store" }
}
