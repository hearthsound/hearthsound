  "query": "SELECT al.id, al.title, al.sort_title, al.display_artist, al.year, al.release_date, al.album_type, al.edition, al.track_count, al.file_tags, al.fetched_at, al.page_fetched_at, al.deep_indexed_at, al.viewed_at, al.created_at, al.updated_at FROM albums al WHERE (EXISTS (SELECT 1 FROM album_artists aa WHERE aa.album_id = al.id AND aa.artist_id = ?) OR EXISTS (SELECT 1 FROM tracks t JOIN track_artists ta ON ta.track_id = t.id WHERE t.album_id = al.id AND ta.artist_id = ?)) ORDER BY al.year IS NULL, al.year, al.sort_title, al.id",
