  "db_name": "SQLite",
  "query": "SELECT a.id AS album_id, a.title AS title, a.edition AS edition, f.path AS folder_path, mf.rel_path AS rel_path FROM albums a JOIN tracks t ON t.album_id = a.id JOIN media_files mf ON mf.track_id = t.id AND mf.storage = 'folder' JOIN library_folders f ON f.id = mf.folder_id WHERE a.origin = 'local' ORDER BY a.id, mf.is_preferred DESC, mf.added_at, mf.rel_path",
