  "query": "SELECT ar.id, ar.name, ar.sort_name, ar.mb_artist_id, ar.origin, ar.created_at, ar.updated_at FROM plays p JOIN track_artists ta ON ta.track_id = p.track_id AND ta.position = 0 JOIN artists ar ON ar.id = ta.artist_id WHERE p.user_id = ? ORDER BY p.started_at DESC, p.id DESC LIMIT 1",
