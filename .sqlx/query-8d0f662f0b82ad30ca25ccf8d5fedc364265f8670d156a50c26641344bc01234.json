  "query": "SELECT mf.id AS id, mf.track_id AS track_id, mf.storage AS storage, mf.rel_path AS rel_path, COALESCE(tr.pinned, 0) AS \"pinned!: i64\" FROM media_files mf LEFT JOIN track_retention tr ON tr.track_id = mf.track_id WHERE (mf.storage = 'cache' AND COALESCE(tr.pinned, 0) = 1) OR (mf.storage = 'library' AND COALESCE(tr.pinned, 0) = 0) ORDER BY mf.storage, mf.rel_path, mf.id",
