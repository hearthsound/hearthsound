  "query": "SELECT p.id, p.owner_user_id, p.name, p.comment, p.is_public, p.is_temporary, p.expires_at, p.source_instance_id, p.source_ref, p.created_at, p.updated_at, pi.display_name AS source_instance_name FROM playlists p LEFT JOIN provider_instances pi ON pi.id = p.source_instance_id WHERE (p.owner_user_id = ?1 OR p.is_public = 1) AND (?2 IS NULL OR p.owner_user_id = ?2) ORDER BY p.name, p.id",
