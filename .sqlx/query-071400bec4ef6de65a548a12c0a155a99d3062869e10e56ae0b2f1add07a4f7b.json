{
  "db_name": "SQLite",
  "query": "WITH scope_tracks(track_id) AS ( SELECT id FROM tracks WHERE availability IN (?, ?) ) SELECT ar.id, ar.name, ar.sort_name, ar.mb_artist_id, ar.origin, ar.created_at, ar.updated_at, (SELECT COUNT(DISTINCT al.id) FROM albums al JOIN album_artists aa ON aa.album_id = al.id AND aa.artist_id = ar.id JOIN tracks t ON t.album_id = al.id JOIN scope_tracks st ON st.track_id = t.id) AS album_count FROM artists ar WHERE ar.id IN (SELECT ta.artist_id FROM track_artists ta JOIN scope_tracks st ON st.track_id = ta.track_id) OR ar.id IN (SELECT aa.artist_id FROM album_artists aa WHERE aa.album_id IN ( SELECT t.album_id FROM tracks t JOIN scope_tracks st ON st.track_id = t.id)) ORDER BY ar.sort_name, ar.id LIMIT ? OFFSET ?",
