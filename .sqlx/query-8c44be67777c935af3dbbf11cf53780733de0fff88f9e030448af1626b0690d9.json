  "query": "SELECT mf.id AS id, mf.track_id AS track_id, mf.rel_path AS rel_path, mf.size AS size, mf.added_at AS added_at, COALESCE(mf.last_accessed_at, mf.added_at) AS \"used_at!: i64\", (SELECT COUNT(*) FROM plays p WHERE p.track_id = mf.track_id) AS \"plays!: i64\" FROM media_files mf LEFT JOIN track_retention tr ON tr.track_id = mf.track_id WHERE mf.storage = 'cache' AND COALESCE(tr.pinned, 0) = 0",
