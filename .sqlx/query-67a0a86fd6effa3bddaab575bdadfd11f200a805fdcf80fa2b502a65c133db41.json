  "query": "SELECT np.user_id, u.username, np.client, np.track_id, np.started_at FROM now_playing np JOIN users u ON u.id = np.user_id LEFT JOIN tracks t ON t.id = np.track_id WHERE np.started_at + COALESCE(t.duration_ms, 0) + (CASE WHEN t.duration_ms IS NULL THEN 1800000 ELSE 600000 END) > ? ORDER BY np.started_at DESC, np.user_id, np.client",
