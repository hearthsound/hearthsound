  "query": "SELECT ul.entity_id AS track_id, t.title AS title, t.display_artist AS artist, t.album_id AS album_id, al.title AS album, t.duration_ms AS duration_ms, ul.added_at AS added_at FROM user_library ul JOIN tracks t ON t.id = ul.entity_id LEFT JOIN albums al ON al.id = t.album_id WHERE ul.user_id = ? AND ul.entity_kind = 'track' AND ul.origin = 'upload' ORDER BY ul.added_at DESC, ul.entity_id ASC",
