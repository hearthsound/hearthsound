  "query": "SELECT a.id, a.track_id, a.priority, a.state, a.progress, a.failure_reason, a.created_at, a.updated_at, t.title AS track_title, t.display_artist AS track_artist, i.slug AS instance_slug FROM acquisitions a LEFT JOIN tracks t ON t.id = a.track_id LEFT JOIN provider_instances i ON i.id = a.instance_id WHERE (? IS NULL OR a.state = ?) AND (? = 0 OR a.state IN ('queued', 'resolving', 'searching', 'downloading', 'verifying', 'importing')) ORDER BY a.created_at DESC, a.rowid DESC LIMIT ?",
